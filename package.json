{
  "name": "team-toolkit",
  "version": "0.4.18",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis",
    "prepare:runtimes": "node scripts/prepare-runtimes.cjs",
    "test": "node --test test/*.test.cjs",
    "tools:sync": "node scripts/sync-tools.cjs",
    "tools:verify": "node scripts/sync-tools.cjs --verify",
    "prepack": "npm run tools:verify && node scripts/check-sycm-runtime.cjs",
    "predist:mac": "npm run tools:verify && node scripts/check-sycm-runtime.cjs mac-arm64",
    "predist:win": "npm run tools:verify && node scripts/check-sycm-runtime.cjs win-x64",
    "smoke:taobao": "node scripts/smoke-taobao.cjs",
    "prepare:sycm": "node scripts/prepare-sycm.cjs",
    "smoke:sycm": "node scripts/smoke-sycm.cjs"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.team.toolkit",
    "productName": "钊叔工具箱",
    "electronLanguages": [
      "zh-CN",
      "zh_CN"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "updater.cjs",
      "update-config.json",
      "business/**/*",
      "!business/monthly-python/**/*",
      "modules/**/*",
      "!business/sycm-python/**/*"
    ],
    "mac": {
      "extendInfo": {
        "CFBundleDevelopmentRegion": "zh_CN",
        "CFBundleLocalizations": [
          "zh_CN"
        ]
      },
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "runtimes/mac-${arch}",
          "to": "python",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "runtimes/win-${arch}",
          "to": "python",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "installerLanguages": [
        "zh_CN"
      ],
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "钊叔工具箱-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "business/monthly-python",
        "to": "monthly-python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "business/sycm-python",
        "to": "sycm-python",
        "filter": [
          "**/*.py"
        ]
      }
    ]
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.1",
    "playwright-core": "1.56.1"
  }
}
