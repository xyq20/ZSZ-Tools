{
  "name": "team-toolkit",
  "version": "0.4.60",
  "private": true,
  "main": "bootstrap.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "node scripts/dist-windows.cjs",
    "prepare:runtimes": "node scripts/prepare-runtimes.cjs",
    "test": "node --test test/*.test.cjs",
    "tools:sync": "node scripts/sync-tools.cjs",
    "tools:verify": "node scripts/sync-tools.cjs --verify",
    "prepack": "npm run tools:verify && node scripts/check-sycm-runtime.cjs",
    "predist:mac": "npm run tools:verify && node scripts/check-sycm-runtime.cjs mac-arm64",
    "predist:win": "npm run tools:verify && node scripts/check-sycm-runtime.cjs win-x64",
    "smoke:taobao": "node scripts/smoke-taobao.cjs",
    "prepare:sycm": "node scripts/prepare-sycm.cjs",
    "smoke:sycm": "node scripts/smoke-sycm.cjs"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.team.toolkit",
    "productName": "钊叔工具箱",
    "artifactBuildCompleted": "scripts/verify-mac-dmg.cjs",
    "afterPack": "scripts/pack-taobao-reminder-defaults.cjs",
    "electronLanguages": [
      "zh-CN",
      "zh_CN"
    ],
    "files": [
      "bootstrap.cjs",
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "updater.cjs",
      "update-config.json",
      "business/**/*",
      "!business/monthly-python/**/*",
      "!business/taobao-reminders-python/**/*",
      "modules/**/*",
      "!business/sycm-python/**/*",
      "!business/taobao-stock/**/*",
      "!business/hot_update.py",
      "!business/return-rate-python/**/*",
      "!business/erp-stock-rules-python/**/*"
    ],
    "mac": {
      "identity": "-",
      "notarize": false,
      "extendInfo": {
        "CFBundleDevelopmentRegion": "zh_CN",
        "CFBundleLocalizations": [
          "zh_CN"
        ]
      },
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "runtimes/mac-${arch}",
          "to": "python",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "extraResources": [
        {
          "from": "runtimes/win-${arch}",
          "to": "python",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "installerLanguages": [
        "zh_CN"
      ],
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "artifactName": "钊叔工具箱-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "business/monthly-python",
        "to": "monthly-python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "business/sycm-python",
        "to": "sycm-python",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "business/taobao-reminders-python",
        "to": "taobao-reminders-python",
        "filter": [
          "qianniu.py",
          "remind.py"
        ]
      },
      {
        "from": "business/taobao-stock",
        "to": "taobao-stock",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "business/hot_update.py",
        "to": "toolkit-update.py"
      },
      {
        "from": "business/return-rate-python",
        "to": "return-rate-python",
        "filter": [
          "bridge.py",
          "return_report.py",
          "report-query.json",
          "excluded-codes.json"
        ]
      },
      {
        "from": "business/erp-stock-rules-python",
        "to": "erp-stock-rules-python",
        "filter": [
          "bridge.py",
          "upload_rules.py"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@img/**/*"
    ]
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.1",
    "playwright-core": "1.56.1",
    "sharp": "0.35.5"
  }
}
